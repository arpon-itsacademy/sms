<IfModule mod_rewrite.c>
    RewriteEngine On

    # Block direct access to hidden files (.env, .git, etc.)
    RewriteRule ^\..* - [F,L]

    # Block direct access to backend directories and sensitive files
    RewriteRule ^(app|bootstrap|config|database|resources|routes|storage|tests|vendor)/ - [F,L,NC]
    RewriteRule ^(artisan|composer\.(json|lock)|package(-lock)?\.json|phpunit\.xml) - [F,L,NC]

    # Route all requests into public folder if document root is set to public_html
    RewriteCond %{REQUEST_URI} !^/public/
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>
