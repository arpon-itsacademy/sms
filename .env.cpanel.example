APP_NAME=ClassDesk
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://tabassumenglish.com
APP_TIMEZONE=Asia/Dhaka
FRONTEND_URL=https://tabassumenglish.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

# Database settings (Enter your cPanel MySQL database details here)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=your_cpanel_database_name
DB_USERNAME=your_cpanel_database_user
DB_PASSWORD=your_cpanel_database_password

# Authentication & Session settings for HTTPS single domain
SANCTUM_STATEFUL_DOMAINS=tabassumenglish.com
SESSION_DOMAIN=tabassumenglish.com
SESSION_SECURE_COOKIE=true
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

# Secret key to run migrations securely from browser (e.g. https://tabassumenglish.com/app-migrate/YOUR_SECRET_KEY)
DEPLOY_KEY=tabassum-secure-migrate-key-2026
